# ==============================================================================
# .HTACCESS - RAIZ PÚBLICA (public_html/.htaccess)
# Compatível com LiteSpeed Web Server e Apache 2.4+ (Hostinger)
# ==============================================================================

# 1. DESATIVAR LISTAGEM DE DIRETÓRIOS E ASSINATURA DO SERVIDOR
Options -Indexes -MultiViews
ServerSignature Off

# 2. DEFINIR CHARSET PADRÃO E TIMEZONE
AddDefaultCharset UTF-8

# 3. BLOQUEIO DE ARQUIVOS OCULTOS, BACKUPS E EXTENSÕES PERIGOSAS
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|yml|yaml|twig|md|lock|json))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. PREVENÇÃO DE EXECUÇÃO DE SCRIPTS NA PASTA DE UPLOADS (ANTI-WEBSHELL)
# Bloqueia qualquer tentativa de rodar .php, .phtml, .php5 dentro de uploads
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.php$ - [F,L,NC]
    RewriteRule ^uploads/.*\.phtml$ - [F,L,NC]
</IfModule>

# 5. HEADERS DE SEGURANÇA (OWASP RECOMMENDED)
<IfModule mod_headers.c>
    # Forçar HTTPS com HSTS (1 ano, subdomínios, pré-carregamento)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Prevenir MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevenir Clickjacking (permitir apenas no mesmo domínio)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Política de Referenciador Restritiva (privacidade do cliente)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desativar recursos de hardware sensíveis não utilizados na loja
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"

    # Content Security Policy (ajustada para e-commerce, Google Fonts, ASAAS e Cloudflare Turnstile)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.asaas.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://static.asaas.com https://*.asaas.com; connect-src 'self' https://challenges.cloudflare.com https://api.asaas.com https://sandbox.asaas.com; frame-src 'self' https://challenges.cloudflare.com; base-uri 'self'; form-action 'self';"

    # Remover headers reveladores de versão
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# 6. OTIMIZAÇÃO: COMPRESSÃO GZIP / BROTLI
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 7. CACHE DE ARQUIVOS ESTÁTICOS (CORE WEB VITALS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Imagens
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fontes
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    
    # CSS e JavaScript (com cache busting de versão)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 8. ROTEAMENTO DO FRONT CONTROLLER (URLS AMIGÁVEIS E HTTPS)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forçar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remover barra final desnecessária (evita conteúdo duplicado no SEO)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Encaminhar todas as requisições que não sejam arquivos reais para o index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
