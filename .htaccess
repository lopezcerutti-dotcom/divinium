# ==============================================================================
# .HTACCESS - DIVINIUM E-COMMERCE (public_html/.htaccess)
# Compatível com LiteSpeed Web Server, Apache 2.4+ e Hostinger hPanel
# ==============================================================================

# Forçar index.php como único ponto de entrada para impedir conflitos com default.php da Hostinger
DirectoryIndex index.php

# Front Controller gerencia respostas de erro diretamente no PHP
# Removidos ErrorDocument 404 e 500 para impedir loops recursivos de subrequest no LiteSpeed / Hostinger

# 1. DESATIVAR LISTAGEM DE DIRETÓRIOS COM SEGURANÇA (MOD_GUARDS)
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# 2. DEFINIR CHARSET PADRÃO
AddDefaultCharset UTF-8

# 3. BLOQUEIO DE ARQUIVOS OCULTOS, BACKUPS E SCRIPTS SENSÍVEIS DO BACKEND
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|yml|yaml|twig|md|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. PREVENÇÃO DE EXECUÇÃO DE SCRIPTS NA PASTA DE UPLOADS (ANTI-WEBSHELL)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.php$ - [F,L,NC]
    RewriteRule ^uploads/.*\.phtml$ - [F,L,NC]
</IfModule>

# 5. HEADERS DE SEGURANÇA (OWASP RECOMMENDED)
<IfModule mod_headers.c>
    # Prevenir MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevenir Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Política de Referenciador Restritiva
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desativar recursos de hardware sensíveis não utilizados na loja
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"

    # Remover headers reveladores de versão
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# 6. OTIMIZAÇÃO: COMPRESSÃO GZIP / BROTLI
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 7. CACHE DE ARQUIVOS ESTÁTICOS (CORE WEB VITALS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Imagens
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fontes
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    
    # CSS e JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 8. ROTEAMENTO DO FRONT CONTROLLER (URLS AMIGÁVEIS E HTTPS RESILIENTE)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forçar HTTPS seguro com suporte total a Cloudflare, LiteSpeed e Proxies Hostinger
    # Previne o loop infinito de redirecionamento (ERR_TOO_MANY_REDIRECTS)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP:CF-Visitor} !'"scheme":"https"' [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Se index.php já for o alvo, não reescrever novamente
    RewriteRule ^index.php$ - [L]

    # Encaminhar todas as requisições que não sejam arquivos reais para o index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
