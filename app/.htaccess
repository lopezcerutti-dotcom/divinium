# ==============================================================================
# .HTACCESS - RAIZ PRIVADA (app/.htaccess)
# Bloqueio total e irrestrito de qualquer requisição direta via HTTP
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
